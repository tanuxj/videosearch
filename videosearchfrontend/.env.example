# ─────────────────────────────────────────────────────────────
# SearchInVideo frontend — environment configuration
# Vars prefixed with VITE_ are exposed to the browser via import.meta.env
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Single-page mode ───────────────────────────────────────
# true = the app is one page: add a video (file or a pasted YouTube/Vimeo/
# Twitch URL), let it index, then describe the moment to jump to the scene.
# The sidebar goes away and Clips, Record, Recordings, Teams and Library are
# folded off — their routes redirect to the search page.
#
# Independent of VITE_AUTH_ENABLED, and nothing is removed: every page and
# component stays in the build, so setting this to false restores the full
# workspace with no code change.
VITE_SINGLE_PAGE=false

# ── Open access: accounts disabled ─────────────────────────
# false = no sign-up, no sign-in, no session. Every visitor lands straight on
# the upload-and-search page as one shared guest, so anyone can add a video
# (file upload or a pasted YouTube/Vimeo/Twitch URL), let it index, and search
# it for the scene they want.
#
# This must match AUTH_ENABLED in the backend's .env — the frontend stops
# sending tokens and the backend stops expecting them. Nothing is removed:
# set both back to true and the login/signup flow returns unchanged.
VITE_AUTH_ENABLED=true

# App name shown in the header / brand
VITE_APP_NAME=SearchInVideo

# YouTube Data API v3 key (https://console.cloud.google.com/apis)
# Leave empty to run the UI on the built-in demo video catalog.
VITE_YOUTUBE_API_KEY=

# Optional: point the frontend at your own search backend later.
VITE_API_URL=

# When true, the UI renders bundled demo videos (no network needed).
VITE_ENABLE_MOCK_DATA=true
