# ─────────────────────────────────────────────────────────────
# VideoSearch backend — environment configuration
# Copy this file to .env and adjust as needed.
# ─────────────────────────────────────────────────────────────

APP_NAME=VideoSearch API
APP_ENV=development
APP_DEBUG=false

# Server bind settings (dev)
HOST=127.0.0.1
PORT=3006

# Allowed CORS origins — JSON array or comma-separated list
CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]

LOG_LEVEL=INFO

# ── Object storage (Cloudflare R2) ─────────────────────────
# Uploaded videos and frame thumbnails live here. R2 is S3-compatible;
# leave these unset to fall back to a local data/uploads directory.
# Create a bucket + API token (Object Read & Write) at
# https://dash.cloudflare.com → R2, then fill in:
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=videosearch
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Where uploads go: "auto" = R2 when configured, else local disk.
# "r2" forces the bucket, "local" forces disk (used by tests).
STORAGE_BACKEND=auto

# ── Uploads ────────────────────────────────────────────────
# Hard ceiling per video file (bytes). Files above 5 GiB automatically use
# R2's presigned multipart upload, so the API never buffers the bytes.
# MAX_UPLOAD_BYTES=10737418240   # 10 GiB

# ── Edge streaming (Cloudflare Worker) ─────────────────────
# When STREAM_WORKER_BASE_URL is set, GET /api/v1/videos/{id}/stream-url
# returns a short-lived HMAC-signed URL served by the edge Worker
# (videosearchworker/) instead of proxying video bytes through the API.
# STREAM_SIGNING_SECRET must match the Worker's STREAM_SIGN_SECRET
# (`npx wrangler secret put STREAM_SIGN_SECRET`). Leave unset to keep
# proxying through the API.
STREAM_WORKER_BASE_URL=
STREAM_SIGNING_SECRET=
STREAM_URL_TTL_SECONDS=3600

# ── URL import (paste-a-link) ──────────────────────────────
# Users can index videos by pasting a link (YouTube, Twitch, Zoom, Vimeo,
# or a direct .mp4/.webm file URL). The backend downloads the video with
# yt-dlp, stores it like an upload, then indexes it normally.
URL_IMPORT_ENABLED=true
# Cap on a URL-downloaded video (bytes). Defaults to the same 10 GiB
# ceiling as file uploads.
# URL_IMPORT_MAX_BYTES=10737418240
# yt-dlp format preference: prefer a single progressive MP4 (plays in
# browsers without an ffmpeg merge), fall back to any single file.
# URL_IMPORT_FORMAT=b[ext=mp4]/b
# SSRF guard: URL hosts must resolve to a public address. Leave false in
# production; tests set it true to point imports at a local fixture server.
# URL_IMPORT_ALLOW_PRIVATE=false
# Most videos a single batch import (`POST /api/v1/videos/from-urls`) will
# reserve, after playlist/channel expansion. A channel with hundreds of
# uploads imports its newest N.
# URL_IMPORT_MAX_BATCH=50
# Whether a pasted playlist/channel link expands into its individual videos.
# Off by default: such links are rejected with a clear message instead of
# importing dozens of videos from one paste. Set true to re-enable.
# URL_IMPORT_EXPAND_PLAYLISTS=false

# ── Indexing pipeline ─────────────────────────────────────
# CLIP model id (sentence-transformers). Downloads to the HF cache
# (~600 MB) on the first indexing run.
CLIP_MODEL_NAME=clip-ViT-B-32
# "onnx" (default) runs the CLIP vision tower through onnxruntime
# (~1.4x faster on CPU, identical vectors); "torch" uses the classic
# eager path. Falls back to torch automatically if the export fails.
CLIP_BACKEND=onnx
# Seconds between sampled frames. 1.0 = one frame per second.
FRAME_INTERVAL_SECONDS=1.0
# Scene-aware sampling: only embed a sampled frame whose picture actually
# changed versus the last one kept (mean abs pixel diff on a small grayscale
# proxy >= SCENE_THRESHOLD), or at least once every SCENE_MAX_GAP_SECONDS.
# Long static footage (movies, talks) indexes a fraction of the frames with
# no real search loss. Set SCENE_AWARE_SAMPLING=false for fixed-rate.
SCENE_AWARE_SAMPLING=true
SCENE_THRESHOLD=8.0
SCENE_MAX_GAP_SECONDS=6.0
# Rows per batch when writing embeddings to Postgres.
INDEX_BATCH_SIZE=128

# ── Semantic search ───────────────────────────────────────
# Minimum cosine similarity for a frame to count as a match (0–1).
# Raise it for stricter results, lower it if real matches are missed.
SEARCH_MIN_SIMILARITY=0.24
# Matching frames closer than this (seconds) merge into one scene.
SEARCH_MERGE_WINDOW_SECONDS=2.0

# ── Transcription (speech → text) ──────────────────────────
# Turns the spoken audio into timed text: subtitles on the player plus a
# clickable transcript. Off until STT_API_KEY is set — without it videos
# index exactly as before and report transcript_status="skipped".
#
# Default host is Groq (whisper-large-v3-turbo): roughly 15–30 s for an hour
# of audio, ~$0.04/hr. Get a key at https://console.groq.com/keys.
# Any OpenAI-compatible /audio/transcriptions endpoint works — set
# STT_BASE_URL=https://api.openai.com/v1 and STT_MODEL=whisper-1 for OpenAI.
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
# ISO-639-1 hint (e.g. "en"). Leave empty to auto-detect the language — the
# detected code is stored on the video and used as the subtitle track's
# srclang. Note that Whisper detects from the opening audio, so a video that
# switches language partway is still labelled by how it starts.
# STT_LANGUAGE=
# Audio is split into chunks this long before upload, so every request stays
# under the provider's file-size cap and long videos transcribe in parallel.
# STT_CHUNK_SECONDS=600
# STT_MAX_CONCURRENCY=4
# STT_TIMEOUT_SECONDS=300
# Opus bitrate for the extracted mono 16 kHz audio.
# STT_AUDIO_BITRATE=16k
# Drop segments whose no-speech probability is above this — Whisper otherwise
# invents dialogue over silence and music.
# STT_NO_SPEECH_THRESHOLD=0.6

# ── LLM query expansion (the "middleman") ──────────────────
# When set, every search prompt is rewritten into visual descriptions CLIP
# can actually match, so terse/broken-English queries still land. Any
# OpenAI-compatible endpoint works — OpenAI, Gemini, local vLLM, etc.
# Leave unset to search with the raw prompt.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1            # OpenAI
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  # Gemini
# LLM_MODEL=gpt-4o-mini
# LLM_EXPAND_PROMPTS=2

# ── Postgres database (used by docker-compose) ─────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=videosearch
POSTGRES_USER=videosearch
# Keep this URL-safe (letters/numbers only) until the app URL-encodes it.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://videosearch:change-me@localhost:5434/videosearch

# ── Open access: accounts disabled ─────────────────────────
# false = no signup, no login, no tokens. Anyone who can reach the app can
# upload a video (or paste a YouTube/Vimeo/Twitch URL), have it indexed, and
# search its scenes. Who sees what is decided by GUEST_SESSION_MODE below —
# by default each browser gets its own throwaway session and library.
#
# Nothing is removed: /auth/signup, /auth/login and /auth/refresh answer 404
# while this is off, and setting AUTH_ENABLED=true restores the full
# email + password system with no code change. Keep the frontend's
# VITE_AUTH_ENABLED in step with this value.
AUTH_ENABLED=true

# How identities are handed out while accounts are off:
#
#   per_browser (default) — every browser gets its own throwaway session, the
#     way a disposable-inbox site does. A visitor with no session cookie is
#     issued one, backed by its own account, so they see only the videos they
#     added. A new browser, a private window or cleared cookies all start a
#     fresh, empty session. POST /api/v1/auth/session/reset starts over.
#
#   shared — one account for everybody: every visitor sees, plays and can
#     delete every video. Only for a trusted single-user instance.
GUEST_SESSION_MODE=per_browser

# The session cookie. Opaque, random and httpOnly — it is the only thing tying
# a browser to its videos, so JavaScript must not be able to read it. Scoped
# to "/" so it rides along on video, thumbnail and caption requests too.
# Behind HTTPS set GUEST_COOKIE_SECURE=true; if the API is served from a
# different site than the frontend it also needs SAMESITE=none.
GUEST_COOKIE_NAME=vs_guest
GUEST_COOKIE_TTL_DAYS=30
GUEST_COOKIE_SAMESITE=lax
GUEST_COOKIE_SECURE=false

# Display name every session's account is created with. The email is only the
# template per-session addresses are built from (guest-<id>@sessions.<domain>);
# it must still be a valid address because it is serialised like a real one.
GUEST_USER_NAME=Guest
GUEST_USER_EMAIL=guest@videosearch.internal

# ── Authentication ─────────────────────────────────────────
# Access tokens are 15-minute JWTs; refresh tokens are opaque, rotating,
# stored hashed in Postgres and delivered in an httpOnly cookie.
# Generate a real secret with:  openssl rand -hex 32
# The app refuses to start with this placeholder when APP_ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Refresh cookie. Set REFRESH_COOKIE_SECURE=true behind HTTPS, and
# SAMESITE=none (plus secure) if the API lives on a different site
# than the frontend.
REFRESH_COOKIE_NAME=vs_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
