# ─────────────────────────────────────────────────────────────
# VideoSearch backend — environment configuration
# Copy this file to .env and adjust as needed.
# ─────────────────────────────────────────────────────────────

APP_NAME=VideoSearch API
APP_ENV=development
APP_DEBUG=false

# Server bind settings (dev)
HOST=127.0.0.1
PORT=3006

# Allowed CORS origins — JSON array or comma-separated list
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]

LOG_LEVEL=INFO

# ── Object storage (Cloudflare R2) ─────────────────────────
# Uploaded videos and frame thumbnails live here. R2 is S3-compatible;
# leave these unset to fall back to a local data/uploads directory.
# Create a bucket + API token (Object Read & Write) at
# https://dash.cloudflare.com → R2, then fill in:
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=videosearch
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Where uploads go: "auto" = R2 when configured, else local disk.
# "r2" forces the bucket, "local" forces disk (used by tests).
STORAGE_BACKEND=auto

# ── Indexing pipeline ─────────────────────────────────────
# CLIP model id (sentence-transformers). Downloads to the HF cache
# (~600 MB) on the first indexing run.
CLIP_MODEL_NAME=clip-ViT-B-32
# Seconds between sampled frames. 1.0 = one frame per second.
FRAME_INTERVAL_SECONDS=1.0
# Rows per batch when writing embeddings to Postgres.
INDEX_BATCH_SIZE=128

# ── Postgres database (used by docker-compose) ─────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=videosearch
POSTGRES_USER=videosearch
# Keep this URL-safe (letters/numbers only) until the app URL-encodes it.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://videosearch:change-me@localhost:5434/videosearch

# ── Authentication ─────────────────────────────────────────
# Access tokens are 15-minute JWTs; refresh tokens are opaque, rotating,
# stored hashed in Postgres and delivered in an httpOnly cookie.
# Generate a real secret with:  openssl rand -hex 32
# The app refuses to start with this placeholder when APP_ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Refresh cookie. Set REFRESH_COOKIE_SECURE=true behind HTTPS, and
# SAMESITE=none (plus secure) if the API lives on a different site
# than the frontend.
REFRESH_COOKIE_NAME=vs_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
